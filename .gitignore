# Operating system files
.DS_Store

# IDE and editor settings
.idea/
*.iml
.vscode/
.metadata/
.settings/
.classpath
.project
.factorypath

# Java build output and dependency caches
*.class
*.jar
*.war
*.ear
bin/
out/
build/
target/
.gradle/

# C/C++ build output
*.o
*.obj
*.exe
*.out
*.a
*.so
*.dylib
*.dll
a.out
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Locally compiled C++ solutions (extensionless files)
**/boj[0-9]*
!**/boj[0-9]*.cpp
!**/boj[0-9]*.cc
!**/boj[0-9]*.cxx
**/deque
**/queue
**/stack
**/yamae
**/test
**/[0-9]

# Keep only solution source files under Programmers; compiled executables have no extension.
/programmers/*
!/programmers/**/*.cpp
!/programmers/**/*.cc
!/programmers/**/*.cxx
!/programmers/**/*.java

# Editor-generated scratch files
tempCodeRunnerFile.*

# Legacy per-problem Eclipse ignore files; root rules above cover their contents.
/boj/**/B*/.gitignore
